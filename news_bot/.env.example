BOT_TOKEN=
CHANNEL_ID=
ADMIN_IDS=
LOG_LEVEL=INFO
POST_INTERVAL_HOURS=6
REQUEST_TIMEOUT=30
DATABASE_PATH=
TELEGRAM_PROXY=
# Пример: TELEGRAM_PROXY=http://127.0.0.1:10808

# --- Контент-фабрика ---
# Ключ OpenAI-совместимого API (OpenAI, OpenRouter, vLLM/Ollama); только здесь, не в yaml.
# Обязателен при включённой фабрике (factory.enabled / FACTORY_ENABLED).
LLM_API_KEY=
# База URL OpenAI-совместимого API; перекрывает factory.llm.base_url из sources.yaml.
LLM_BASE_URL=
# Имя модели; перекрывает factory.llm.model из sources.yaml.
LLM_MODEL=
# Прокси для запросов к LLM (socks5://host:port или http://host:port).
# Нужен только для локального запуска, когда провайдер блокирует прямой IP;
# на VPS оставьте пустым — LLM-запросы пойдут напрямую, RSS-сбор всегда прямой.
LLM_PROXY=
# Включение фабрики (true/false); перекрывает factory.enabled из sources.yaml.
FACTORY_ENABLED=
# Интервал цикла фабрики в часах; перекрывает factory.interval_hours из sources.yaml.
FACTORY_INTERVAL_HOURS=
# Окно активности фабрики для docker-healthcheck (ЧЧ:ММ-ЧЧ:ММ, дефолт 08:00-23:00).
# Важно: healthcheck сравнивает окно с локальным временем контейнера (обычно UTC);
# сама фабрика руководствуется factory.timezone из sources.yaml.
FACTORY_ACTIVE_HOURS=
